    "lint": "eslint --ext .js,.vue src functions/index.js",
    "test": "echo \"No test specified\" && exit 0",
    "app": "cp app.yaml functions/default/dist && cd functions/default/dist && gcloud app deploy -q",
    "deploy": "npm run build && firebase deploy --only hosting:icoinuser && firebase deploy --only functions:icoinuser",
    "dispatch": "gcloud app deploy dispatch.yaml"
  },
