{
  "name": "icoinuser",
  "version": "0.0.1",
  "description": "icoinuser",
  "productName": "icoinuser",
  "cordovaId": "org.cordova.quasar.app",
  "capacitorId": "",
  "author": "admin <admin@yomeen.com>",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "olddev": "quasar dev -m ssr --reset-cache",
